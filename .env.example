# Copy to `.env` and edit. Real environment variables override this file.
# Everything here is optional -- the defaults work with no API keys.

# --- Search backend ---
# auto | duckduckgo | searxng | brave | tavily
WEBSEARCH_BACKEND=auto
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080
WEBSEARCH_MAX_RESULTS=50
# Leave blank for the backend default. Examples: us-en, in-en, uk-en.
# WEBSEARCH_REGION=

# --- Page fetching ---
WEBSEARCH_TIMEOUT=20
WEBSEARCH_MAX_PAGE_CHARS=12000
WEBSEARCH_RESEARCH_PAGES=3
WEBSEARCH_RESEARCH_CHARS=4000
WEBSEARCH_READ_PDF=true
WEBSEARCH_MAX_PDF_BYTES=15000000
WEBSEARCH_HTTP_RETRIES=2
WEBSEARCH_RESPECT_ROBOTS=true
# Headless-browser fallback for JS-only pages. Needs a one-time
# `python -m playwright install chromium` (~300 MB). Off by default.
WEBSEARCH_JS_RENDER=false
WEBSEARCH_JS_RENDER_MIN_CHARS=500
# Certificate-Transparency subdomain lookup for /analyze.
WEBSEARCH_SUBDOMAIN_TIMEOUT=12
# Refuses private/loopback addresses. Only disable on a trusted network.
WEBSEARCH_BLOCK_PRIVATE=true

# --- Logging / cache ---
WEBSEARCH_LOG_LEVEL=INFO
WEBSEARCH_CACHE=true
WEBSEARCH_CACHE_TTL=900

# --- Local LLM server (used by the agent + chat web page) ---
# auto | lmstudio | ollama | custom. "auto" probes LM Studio then Ollama.
LLM_PROVIDER=auto
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=          # blank auto-picks a tool-capable model
# Older LMSTUDIO_* names still work.

# --- Chat web page (python -m websearch.webchat) ---
# Where saved conversations are stored (one JSON per chat).
# WEBSEARCH_CONV_DIR=

# --- Burp Suite (authorised security testing only) ---
# With a proxy set, ALL web tools route through it; if it isn't running,
# read_url/research/analyze_site will fail. Comment it out when not using Burp.
# BURP_PROXY=http://127.0.0.1:8080
BURP_PROXY_VERIFY=false
BURP_API_URL=http://127.0.0.1:1337
# BURP_API_KEY=
# BURP_SCAN_CONFIG=
BURP_ALLOW_ACTIVE_SCAN=false

# --- Shodan (used by the shodan skill) ---
# SHODAN_API_KEY=

# --- OWASP ZAP (free alternative to Burp Pro; scanner + API are free) ---
# Proxy and API share one port (default 8090 in daemon mode).
# ZAP_PROXY=http://127.0.0.1:8090
ZAP_PROXY_VERIFY=false
ZAP_API_URL=http://127.0.0.1:8090
# ZAP_API_KEY=
ZAP_ALLOW_ACTIVE_SCAN=false

# --- Self-extension (the model writes its own tools + edits its own code) ---
# The model can author Python functions into SLEUTH_SKILLS_DIR and call them as
# tools immediately, read/patch this package's own source, and run arbitrary
# code. This agent reads untrusted web pages, so with everything on a malicious
# page that talks the model into authoring a skill reaches arbitrary code
# execution with this process's environment (.env keys included). Each gate
# below turns off one capability without touching code.
SLEUTH_SKILLS=true               # master switch for the whole subsystem
# SLEUTH_SKILLS_DIR=              # where authored skills live (default ./skills)
SLEUTH_ALLOW_SELF_EDIT=true      # code_write / code_revert on the project's source
# SLEUTH_CODE_ROOT=              # bound for code_* tools (default project root)
SLEUTH_ALLOW_EXEC=true           # python_exec (in-process) and shell_exec
SLEUTH_EXEC_TIMEOUT=30           # seconds for python_exec / shell_exec
SLEUTH_SKILL_TIMEOUT=60          # seconds an authored skill may run
# SLEUTH_BACKUP_DIR=            # where code_write snapshots go (default ./.backups)
SLEUTH_BACKUP_KEEP=20            # snapshots kept per file
